<view class="page">
  <view class="card">
    <view class="title">{{appName}}</view>
    <view class="aux">版本 {{version}}</view>
  </view>

  <view class="section-title">更新说明</view>
  <view class="card">
    <view wx:for="{{changelog}}" wx:key="version" class="log">
      <view class="log-version">v{{item.version}}</view>
      <view wx:for="{{item.lines}}" wx:key="*this" wx:for-item="line" class="aux">{{line}}</view>
    </view>
  </view>

  <view class="section-title">服务协议</view>
  <view class="card">
    <view>本工具免费提供公历、农历与干支历之间的日期换算和历法科普，全部计算在本机完成。</view>
    <view class="aux agreement-todo">开发者联系方式待补充</view>
  </view>

  <view class="section-title">免责声明</view>
  <view class="disclaimer">{{disclaimer}}</view>
</view>
