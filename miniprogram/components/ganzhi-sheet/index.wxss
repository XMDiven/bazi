.grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--sp-1);
}
.cell {
  min-height: var(--tap);
  line-height: var(--tap);
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: var(--fs-body);
}
.cell-off { opacity: 0.3; }
.cell-on { border-color: var(--accent); color: var(--accent); font-weight: 600; }
.empty-choice { justify-content: center; margin-top: var(--sp-2); }
