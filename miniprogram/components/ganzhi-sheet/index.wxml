<sheet show="{{show}}" title="{{title}}" bind:close="onClose">
  <view class="grid">
    <view
      wx:for="{{cells}}" wx:key="gz"
      class="cell {{item.enabled ? '' : 'cell-off'}} {{item.selected ? 'cell-on' : ''}}"
      aria-disabled="{{!item.enabled}}"
      data-gz="{{item.gz}}" data-enabled="{{item.enabled}}" bindtap="onCell"
      hover-class="{{item.enabled ? 'tap-active' : 'none'}}"
    >{{item.gz}}</view>
  </view>
  <view wx:if="{{allowEmpty}}" class="row empty-choice" bindtap="onEmpty" hover-class="tap-active"><text>不填</text></view>
</sheet>
