.seg {
  display: flex;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 4rpx;
}
.seg-item {
  flex: 1;
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink-2);
  border-radius: 12rpx;
}
.seg-on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
}
