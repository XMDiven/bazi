<view wx:if="{{show}}" class="mask" bindtap="onClose" catchtouchmove="noop"></view>
<view wx:if="{{show}}" class="sheet" catchtap="noop" role="dialog" aria-label="{{title}}">
  <view class="sheet-head">
    <view class="sheet-title">{{title}}</view>
    <view class="sheet-action"><slot name="action"></slot></view>
  </view>
  <scroll-view scroll-y class="sheet-body"><slot></slot></scroll-view>
</view>
