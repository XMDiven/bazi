.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  animation: mask-in 200ms ease-out;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-width: 750rpx;
  margin: 0 auto;
  background: var(--surface);
  border-radius: var(--radius) var(--radius) 0 0;
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-4) + env(safe-area-inset-bottom));
  animation: sheet-in 200ms ease-out;
}
@keyframes sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
/* 退场期间节点还在，屏蔽点击，避免误触正在收起的内容 */
.sheet-leave { animation: sheet-out 200ms ease-in forwards; pointer-events: none; }
.mask-leave { animation: mask-out 200ms ease-in forwards; pointer-events: none; }
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap);
}
.sheet-title { font-size: var(--fs-title); font-weight: 600; }
.sheet-body { max-height: 70vh; }
