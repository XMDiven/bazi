.actions { display: flex; }
.cancel { color: var(--ink-2); min-width: var(--tap); text-align: center; line-height: var(--tap); }
.confirm { color: var(--accent); min-width: var(--tap); text-align: right; line-height: var(--tap); }
/* 3 行可见：日期 + 时间两组滚轮在小屏上也能一屏放下，避免滚轮嵌在可滚动的弹层里 */
.wheel { height: 240rpx; margin: var(--sp-3) 0; }
.wheel-item { line-height: 80rpx; text-align: center; font-size: var(--fs-body); color: var(--ink); }
.wheel-indicator { height: 80rpx; }
.clock-hint { text-align: center; margin-top: calc(-1 * var(--sp-2)); }
.section-label { margin: var(--sp-3) 0 var(--sp-2); }
/* 13 个时辰（子时拆早、晚）排成 4 列宫格，一屏放下，不用滚动 */
.shichen-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); margin-top: var(--sp-3); }
.shichen-cell {
  padding: var(--sp-2) 0;
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  line-height: 1.4;
}
.shichen-name { font-size: var(--fs-body); }
.shichen-range { font-size: var(--fs-min); color: var(--ink-2); }
.shichen-on { border-color: var(--accent); color: var(--accent); font-weight: 600; }
.shichen-on .shichen-range { color: var(--accent); font-weight: normal; }
