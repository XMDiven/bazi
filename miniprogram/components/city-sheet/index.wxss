/* 弹层本身不滚动（scroll=false），这里固定高度并分区：搜索、快捷选择固定，省市两栏各自滚动 */
.picker { height: 70vh; display: flex; flex-direction: column; }
.search {
  flex: none;
  display: flex;
  align-items: center;
  height: var(--tap);
  padding-left: var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--paper);
  margin-bottom: var(--sp-2);
}
.search-input { flex: 1; height: var(--tap); }
.search-clear { width: var(--tap); height: var(--tap); line-height: var(--tap); text-align: center; color: var(--ink-2); font-size: var(--fs-title); }
.pane { flex: 1; min-height: 0; height: 100%; }
.city-on { color: var(--accent); font-weight: 600; }
.empty-search { padding: var(--sp-3) 0; text-align: center; }

.quick-label { flex: none; margin: var(--sp-1) 0; }
.quick { flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); margin-bottom: var(--sp-2); }
.quick-chip {
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: var(--fs-aux);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 var(--sp-1);
}
.quick-on { border-color: var(--accent); color: var(--accent); font-weight: 600; }

.cols { flex: 1; min-height: 0; display: flex; border-top: 1rpx solid var(--line); }
.col-left { width: 180rpx; height: 100%; background: var(--paper); }
.col-right { flex: 1; height: 100%; padding-left: var(--sp-3); box-sizing: border-box; }
.prov {
  position: relative;
  min-height: var(--tap);
  line-height: var(--tap);
  text-align: center;
  color: var(--ink-2);
  font-size: var(--fs-aux);
}
.prov-on { background: var(--surface); color: var(--ink); font-weight: 600; }
/* 已选城市所在的省：翻看别的省时也能找回来 */
.prov-dot { position: absolute; top: 50%; right: 16rpx; width: 10rpx; height: 10rpx; margin-top: -5rpx; border-radius: 50%; background: var(--accent); }
.city-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); padding: var(--sp-2) 0; }
.city-cell {
  min-height: 72rpx;
  padding: var(--sp-1) 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.3;
  font-size: var(--fs-aux);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
}
.cell-on { border-color: var(--accent); color: var(--accent); font-weight: 600; }

.foot {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--line);
}
.foot-none { min-height: var(--tap); line-height: var(--tap); }
