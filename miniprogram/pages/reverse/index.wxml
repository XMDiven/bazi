<view class="page">
  <view class="title rv-title">{{title}}</view>
  <notice lines="{{notice}}" />
  <block wx:if="{{status === 'ok'}}">
    <view wx:for="{{items}}" wx:key="index" class="list-item reverse-item" data-index="{{item.index}}" bindtap="onItem">{{item.text}}</view>
  </block>
  <empty-state wx:elif="{{status === 'empty'}}" text="1900 年至今没有符合这组四柱的时刻">
    <view class="link k4" bindtap="openK4">为什么有些干支组合不存在</view>
  </empty-state>
</view>
