<view class="page">
  <view class="head-row">
    <view class="nav-btn" bindtap="onPrev" aria-label="上个月" hover-class="tap-active">‹</view>
    <picker mode="date" fields="month" value="{{pickerValue}}" start="{{pickerStart}}" end="{{pickerEnd}}" bindchange="onPick">
      <view id="month-title" class="title" hover-class="tap-active">{{title}} · {{yearGanZhiText}}<text class="chevron"> ›</text></view>
    </picker>
    <view class="nav-btn" bindtap="onNext" aria-label="下个月" hover-class="tap-active">›</view>
    <view id="today" class="today-btn link" bindtap="onToday" hover-class="tap-active">今天</view>
  </view>

  <month-grid id="month-grid" cells="{{cells}}" bind:select="onSelect" bind:prev="onPrev" bind:next="onNext" />

  <view wx:if="{{detail}}" class="card day-summary">
    <view class="title">{{detail.solarText}}</view>
    <view>{{detail.lunarText}} · {{detail.shengXiao}}</view>
    <view>{{detail.ganzhiText}}</view>
    <view wx:if="{{detail.term}}">{{detail.term.name}} {{detail.term.timeText}} 交节</view>
    <view wx:if="{{detail.festivals.length}}" class="aux">{{festivalText}}</view>
    <view class="row summary-foot">
      <text class="aux">{{nextTermText}}</text>
      <view id="open-terms" class="link" bindtap="openTerms" hover-class="tap-active">节气表</view>
    </view>
    <button id="open-day" class="btn-plain" bindtap="openDay">查看日详情</button>
  </view>
</view>
